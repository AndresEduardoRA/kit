{
  "name": "kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/worktree/con-carril.sh next dev",
    "funciones": "bash scripts/worktree/con-carril.sh supabase functions serve",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && pnpm -s test:kit",
    "test:watch": "vitest",
    "test:kit": "node --test scripts/lib/*.test.mjs scripts/proyecto/*.test.mjs scripts/orquestador/*.test.mjs",
    "test:guardas": "vitest run .test.ts",
    "test:e2e": "NEXT_DIST_DIR=.next-e2e next build && E2E_PROD=1 bash scripts/candado.sh test:e2e -- playwright test",
    "test:e2e:completo": "bash scripts/candado.sh test:e2e:completo -- node scripts/e2e-completo.mjs",
    "db:reset": "bash scripts/candado.sh db:reset -- supabase db reset",
    "db:types": "bash scripts/candado.sh db:types -- sh -c 'supabase gen types typescript --local --schema public > src/shared/types/database.types.ts' && prettier --ignore-path .gitignore --write src/shared/types/database.types.ts",
    "db:diff": "bash scripts/candado.sh db:diff -- supabase db diff -f",
    "db:probar": "node scripts/probar-schema.mjs supabase",
    "db:probar:rapido": "PROBAR_RAPIDO=1 node scripts/probar-schema.mjs supabase",
    "db:lint": "bash scripts/candado.sh db:lint -- supabase db lint --fail-on error",
    "mapa": "bash scripts/mapa.sh",
    "env:check": "tsx scripts/env-check.ts",
    "contrato:generar": "bash scripts/candado.sh contrato:generar -- tsx scripts/contratos/contrato.ts generar",
    "contrato:probar": "bash scripts/candado.sh contrato:probar -- tsx scripts/contratos/contrato.ts probar",
    "contrato:tipos": "tsx scripts/contratos/contrato.ts tipos",
    "contrato:usar": "tsx scripts/contratos/contrato.ts usar",
    "kit:nuevo": "node scripts/kit/nuevo-proyecto.mjs",
    "kit:publicar": "node scripts/kit/publicar-proyecto.mjs",
    "test:generador": "node --test scripts/kit/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.3",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "pg": "8.23.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
