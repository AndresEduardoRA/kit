# Las variables de la app (`pnpm env:check` dice qué falta, sin imprimir valores). Copia este archivo a `.env.local` y llénalo.
# semilla-a-repo ajusta los puertos al bloque del proyecto (PILOTO_BLOQUE de piloto.config; scripts/lib/stack-local.mjs).

# Supabase (local: `pnpm exec supabase start` te imprime estos valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Sólo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Correo de la app (src/shared/lib/email): ninguno | mailpit. Sin proveedor no se manda nada.
EMAIL_PROVEEDOR=ninguno
EMAIL_REMITENTE=avisos@correo.ejemplo.com
EMAIL_REMITENTE_NOMBRE=Mi proyecto
# Mailpit, el correo local de Supabase ([local_smtp] de supabase/config.toml)
MAILPIT_URL=http://127.0.0.1:55324
