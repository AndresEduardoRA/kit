# La configuración del piloto y del coordinador de ESTE proyecto. Se versiona: no lleva secretos (las claves van en .env.local, que
# no se versiona). La escribe semilla-a-repo desde la semilla; se puede editar a mano. Lo cargan los scripts con `source`.

# El nombre corto del proyecto (el slug de la semilla): va en los project_id de Supabase y en las sesiones de tmux.
PROYECTO=cambiar-slug

# El bloque de puertos (1 a 9, nunca 4): dos proyectos que corren a la vez llevan bloques distintos. scripts/lib/stack-local.mjs.
PILOTO_BLOQUE=5

# Cuántos carriles corren a la vez como máximo. Cada uno levanta su Supabase (≈ 0,85 GB de RAM, medido en importadora) y su e2e.
CARRILES_MAX=3

# Compuerta ámbar: si nadie responde en estos minutos, el piloto elige la opción recomendada y lo anota en la bitácora del paso.
# Las rojas esperan siempre.
PILOTO_AUTO_MIN=5

# Las compuertas que se contestan solas, al instante y sin abrir la sesión de decidir (separadas por coma): `producto` con la
# recomendada, `datos` y `guardas` con «aprobar» (el diff de guardas queda en .piloto/guardas/). Cada una queda anotada y el paso la
# copia a docs/pasos/<PASO>/decisiones.md. Vacío = ninguna. Con `datos` se pierde la aprobación humana del plan de RLS, permisos y
# dinero antes de ejecutarlo: lo decide el dueño. Las paradas nunca se contestan solas.
PILOTO_AUTO=

# Topes de gasto por paso, en USD equivalentes (total_cost_usd de `claude -p`). Calibrados en importadora: un paso grande costó 43,55.
PILOTO_TOPE_USD_PASO=60
PILOTO_TOPE_USD_MIN=5
PILOTO_DISCO_MAX=90

# Las funciones edge que el e2e completo exige servidas (separadas por espacio; vacío = ninguna).
PILOTO_FUNCIONES=""

# Segundos que un carril sin paso libre espera antes de volver a preguntar al coordinador.
PILOTO_ESPERA_S=120

# Fable con `claude -p` puede cobrar créditos de uso sin preguntar: con 0, el bucle te pide permiso una vez por paso.
PILOTO_FABLE_OK=0

# Qué PR integra el coordinador solo, con el CI en verde. Sin `rojo`, los rojos los integra la persona; con `rojo`, también entran
# solos (se pierde la última mirada humana en RLS, permisos y dinero: lo decide el dueño).
COORD_MERGE_AUTO=verde,ambar

# El % de la ventana de 5 h que puede usar este proyecto (tope_cuota.ventana_5h_pct de la semilla). Pasarlo es una compuerta roja.
COORD_TOPE_PCT=100
# Con la cuota sobre esta fracción del tope, sólo avanzan los pasos del camino crítico.
COORD_UMBRAL=0.8

# COORD_USD_VENTANA (cuánto es una ventana de 5 h entera, en USD equivalentes) es de la CUENTA, no del proyecto: va en
# ~/.config/kit/cuenta.config, junto con ~/.config/kit/proyectos.txt (las raíces de los proyectos que comparten la cuota).
[ -f "$HOME/.config/kit/cuenta.config" ] && . "$HOME/.config/kit/cuenta.config"
export PROYECTO PILOTO_BLOQUE CARRILES_MAX PILOTO_AUTO_MIN PILOTO_AUTO PILOTO_TOPE_USD_PASO PILOTO_TOPE_USD_MIN PILOTO_DISCO_MAX \
  PILOTO_FUNCIONES PILOTO_ESPERA_S PILOTO_FABLE_OK \
  COORD_MERGE_AUTO COORD_TOPE_PCT COORD_UMBRAL COORD_USD_VENTANA
